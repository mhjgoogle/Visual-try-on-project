{
  "skillId": "script-doctor",
  "skillVersion": 2,
  "work": "review",
  "role": "剧本医生",
  "title": "Script Doctor",
  "purpose": "找出剧本的结构问题并给出**具体**修改建议（不改写全篇）。",
  "inputs": [
    "episodeScript"
  ],
  "optionalInputs": [
    "outline",
    "episodePlan",
    "characters",
    "relationships"
  ],
